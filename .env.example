# Database Type: 'mysql' or 'sqlite'
DB_TYPE=sqlite

# MySQL Settings (used if DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cricket_stats

# SQLite Settings
SQLITE_DB_PATH=database/cricket_stats.db

# External Cricket Live API (CricAPI / cricapi.com)
CRICKET_API_KEY=your_api_key_here

PORT=5000
DEBUG=True
